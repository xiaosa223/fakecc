{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "bun run build:custom && pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/package-browser.ps1"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CCBaga-A",
        "width": 1160,
        "height": 860,
        "minWidth": 760,
        "minHeight": 640,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../terminal-setup/Configure.cmd": "terminal-setup/Configure.cmd",
      "../terminal-setup/StartClaude.cmd": "terminal-setup/StartClaude.cmd",
      "../terminal-setup/CheckEnvironment.cmd": "terminal-setup/CheckEnvironment.cmd",
      "../terminal-setup/scripts/Core.ps1": "terminal-setup/scripts/Core.ps1",
      "../terminal-setup/scripts/Setup.ps1": "terminal-setup/scripts/Setup.ps1",
      "../terminal-setup/scripts/Launch.ps1": "terminal-setup/scripts/Launch.ps1",
      "../terminal-setup/scripts/Doctor.ps1": "terminal-setup/scripts/Doctor.ps1",
      "../terminal-setup/scripts/TerminalHost.ps1": "terminal-setup/scripts/TerminalHost.ps1",
      "../LICENSE": "licenses/LICENSE.CCBaga.txt",
      "../NOTICE.md": "licenses/NOTICE.md",
      "../dist/": "browser-ui/",
      "../browser-runtime/version.txt": "browser-runtime/version.txt",
      "../browser-runtime/LICENSE.fingerprint-chromium": "browser-runtime/LICENSE.fingerprint-chromium",
      "../browser-runtime/WindowsBrowser/": "browser-runtime/WindowsBrowser/",
      "../browser-runtime/icons/browser.ico": "browser-runtime/icons/browser.ico",
      "windows/LICENSE.unicode.txt": "licenses/LICENSE.unicode.txt"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese"
        ],
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
